<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <!-- Configuration pour les Single Page Applications avec React Router -->
    <rewrite>
      <rules>
        <rule name="React Routes" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <!-- Ne pas rediriger si c'est un fichier existant -->
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <!-- Ne pas rediriger si c'est un dossier existant -->
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <!-- Ne pas rediriger les fichiers d'assets -->
            <add input="{REQUEST_URI}" pattern="^/(assets|favicon\.ico|robots\.txt|.*\.(js|css|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|eot|json))" negate="true" />
          </conditions>
          <!-- Rediriger toutes les autres requêtes vers index.html -->
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>

    <!-- Configuration du MIME types pour s'assurer que tous les fichiers sont servis correctement -->
    <staticContent>
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <mimeMap fileExtension=".woff" mimeType="application/font-woff" />
      <mimeMap fileExtension=".woff2" mimeType="application/font-woff2" />
    </staticContent>

    <!-- Activer la compression pour améliorer les performances -->
    <urlCompression doStaticCompression="true" doDynamicCompression="true" />

    <!-- Définir les erreurs personnalisées si nécessaire -->
    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" />
      <error statusCode="404" path="/index.html" responseMode="ExecuteURL" />
    </httpErrors>
  </system.webServer>
</configuration>
